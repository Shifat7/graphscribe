## Behavior: Agentic calendar actions through tool use (CRUD + event priority scheduling)

**Description:**
Enables the agent to perform Create, Read, Update, and Delete (CRUD) operations on calendar events, as well as schedule events based on priority using the Google Calendar API. The agent can create new events, update or delete existing ones, and automatically find optimal time slots for high-priority events by analyzing the user's calendar availability.

**Python Example:**

```python
from google_auth import get_google_service
from datetime import datetime, timedelta

# Create a new event
def create_event(summary, start_time, end_time, calendar_id='primary'):
    service = get_google_service('calendar', 'v3', 'calendar')
    event = {
        'summary': summary,
        'start': {'dateTime': start_time, 'timeZone': 'UTC'},
        'end': {'dateTime': end_time, 'timeZone': 'UTC'},
    }
    created_event = service.events().insert(calendarId=calendar_id, body=event).execute()
    return created_event['id']

# Read upcoming events
def list_events(calendar_id='primary', max_results=10):
    service = get_google_service('calendar', 'v3', 'calendar')
    now = datetime.utcnow().isoformat() + 'Z'
    events_result = service.events().list(calendarId=calendar_id, timeMin=now,
                                         maxResults=max_results, singleEvents=True,
                                         orderBy='startTime').execute()
    return events_result.get('items', [])

# Update an event
def update_event(event_id, summary=None, start_time=None, end_time=None, calendar_id='primary'):
    service = get_google_service('calendar', 'v3', 'calendar')
    event = service.events().get(calendarId=calendar_id, eventId=event_id).execute()
    if summary:
        event['summary'] = summary
    if start_time:
        event['start']['dateTime'] = start_time
    if end_time:
        event['end']['dateTime'] = end_time
    updated_event = service.events().update(calendarId=calendar_id, eventId=event_id, body=event).execute()
    return updated_event

# Delete an event
def delete_event(event_id, calendar_id='primary'):
    service = get_google_service('calendar', 'v3', 'calendar')
    service.events().delete(calendarId=calendar_id, eventId=event_id).execute()
    return True

# Priority scheduling: find next available slot and schedule event
def schedule_priority_event(summary, duration_minutes=60, calendar_id='primary'):
    service = get_google_service('calendar', 'v3', 'calendar')
    now = datetime.utcnow()
    events = list_events(calendar_id=calendar_id, max_results=50)
    busy_times = [(datetime.fromisoformat(e['start']['dateTime'].replace('Z','')), datetime.fromisoformat(e['end']['dateTime'].replace('Z',''))) for e in events if 'dateTime' in e['start']]
    # Find next available slot
    slot_start = now
    slot_end = slot_start + timedelta(minutes=duration_minutes)
    while any(bs < slot_end and be > slot_start for bs, be in busy_times):
        slot_start += timedelta(minutes=15)
        slot_end = slot_start + timedelta(minutes=duration_minutes)
    # Schedule event
    return create_event(summary, slot_start.isoformat()+'Z', slot_end.isoformat()+'Z', calendar_id)

# Example usage:
if __name__ == "__main__":
    # Create an event
    event_id = create_event("Test Event", "2024-07-20T15:00:00Z", "2024-07-20T16:00:00Z")
    print(f"Created event: {event_id}")
    # List events
    events = list_events()
    print(f"Upcoming events: {[e['summary'] for e in events]}")
    # Update event
    update_event(event_id, summary="Updated Test Event")
    # Delete event
    delete_event(event_id)
    # Priority scheduling
    scheduled_id = schedule_priority_event("High Priority Meeting", 30)
    print(f"Scheduled high priority event: {scheduled_id}")
```

**Setup:**
- Install dependencies: `pip install --upgrade google-api-python-client google-auth-httplib2 google-auth-oauthlib`
- Follow the [Google Calendar API Python Quickstart](https://developers.google.com/calendar/api/quickstart/python) to create OAuth2 credentials and obtain `token.json`.
- Place `token.json` in your working directory.
- Run the script to perform CRUD and priority scheduling actions on your calendar.

